# Langue de la sortie et du résumé IA : fr (défaut) ou en.
APP_LOCALE=fr

# Tracker à interroger. Adapters disponibles : jira (défaut).
TRACKER=jira

# Clé du projet / board par défaut, utilisée quand --project est omis.
TRACKER_PROJECT=ACME

# Personne ciblée quand --user est absent (défaut : le compte du tracker,
# c'est-à-dire JIRA_EMAIL pour l'adapter Jira). Vide = tout le board.
TRACKER_USER=

# --- Adapter jira (requis quand TRACKER=jira) ---
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=bot@example.com
JIRA_API_TOKEN=your_atlassian_api_token

# Champ custom portant la note de root cause (optionnel).
# Id trouvable dans Jira > Paramètres > Tickets > Champs personnalisés
# (customfield_XXXXX). Si ce champ suit le gabarit Problème / Cause /
# Correction / Prévention, le CLI en extrait la Cause comme root cause et la
# Correction comme fix : JIRA_CORRECTION_FIELD reste alors vide. Ne le remplir
# que si un champ séparé porte le fix (il écrase la Correction extraite).
JIRA_ROOT_CAUSE_FIELD=
JIRA_CORRECTION_FIELD=

# Source du narratif IA, par ordre de priorité :
#  1. CLI `claude` local (réutilise le login Claude Code, AUCUNE clé) — automatique
#  2. ANTHROPIC_API_KEY ci-dessous (fallback si le CLI est absent)
#  3. aucune (métriques seules)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
